# Settings for the server, as environment variables. All are optional.
# Set them on your host, or pass this file to Docker: docker run --env-file .env ...

# Protect predictions and metrics: comma-separated keys, 16+ characters each, sent by
# callers as X-API-Key. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ETA_API_KEYS=

# Other websites that may call the API from a browser, comma-separated.
ETA_CORS_ORIGINS=

# Interactive API docs at /docs, and Prometheus metrics at /metrics.
ETA_DOCS=true
ETA_METRICS=true

# Limits.
ETA_MAX_BATCH=500
ETA_MAX_BODY_BYTES=1000000

# DEBUG, INFO, WARNING or ERROR.
ETA_LOG_LEVEL=INFO
